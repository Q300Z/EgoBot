# =========================================================
# Variables d'environnement — Worker EgoBot
# =========================================================
# Copier en `apps/worker/.env` avant le premier lancement.
# =========================================================

# ---------------------------------------------------------
# 1. Environnement — À ACCORDER AVEC apps/api/.env
# ---------------------------------------------------------

# NODE_ENV détermine le préfixe des files Valkey :
#   jobs:queue:<env>:<modèle>
#
# L'API et le worker le normalisent tous deux en "dev" ou "prod"
# (development | dev | test → dev, tout le reste → prod). Cette valeur DOIT
# donc produire le même résultat des deux côtés, sinon l'API publie dans une
# file que personne ne consomme : les messages partent, aucune réponse ne
# revient, et rien n'apparaît dans les journaux.
#
# Le piège : sans .env du tout, les deux retombent sur "prod" et s'accordent.
# C'est le fait de configurer apps/api/.env avec NODE_ENV=development, comme
# le recommande le README, qui casse l'accord si ce fichier-ci est absent.
#
# Chaque processus affiche son préfixe au démarrage : en cas de doute,
# comparer les deux lignes.
NODE_ENV=development

# ---------------------------------------------------------
# 2. Valkey — file de travail partagée avec l'API
# ---------------------------------------------------------

REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------
# 3. Base de l'agent logistique
# ---------------------------------------------------------

# Base SQLite de packages/logistics-agent (clients, commandes, livraisons).
#
# ATTENTION : cette variable porte un sens DIFFÉRENT côté apps/api, où elle
# désigne la base des comptes et conversations. Les deux applications lisent
# leur propre .env, ne jamais définir DATABASE_URL globalement.
#
# Un chemin absolu est recommandé : le worker s'exécute depuis apps/worker,
# un chemin relatif y créerait une seconde base au mauvais endroit.
DATABASE_URL="file:/chemin/absolu/vers/packages/logistics-agent/prisma/logistics.db"

# ---------------------------------------------------------
# 4. Modèle de l'agent logistique
# ---------------------------------------------------------

# C'est ici que la configuration du modèle doit vivre, et non dans
# packages/logistics-agent/.env : le worker charge son propre .env et c'est
# lui qui construit l'agent. Le .env du paquet n'est lu que par la CLI Prisma.
#
# Sans configuration, les jobs CHATBOT fonctionnent, mais tout job LOGISTICS
# échoue à l'instanciation du modèle.

LOGISTICS_MODEL_PROVIDER=openai

# Option 1 — OpenAI
# OPENAI_API_KEY="sk-..."

# Option 2 — Azure OpenAI / Azure AI Foundry (LOGISTICS_MODEL_PROVIDER=azure)
# AZURE_OPENAI_API_KEY="..."
# AZURE_OPENAI_ENDPOINT="https://mon-instance.services.ai.azure.com"
# AZURE_OPENAI_API_DEPLOYMENT_NAME="mon-deploiement"
# AZURE_OPENAI_API_VERSION="2024-10-21"

# Modèle utilisé par l'agent. Facultatif — défaut : gpt-5.
LOGISTICS_MODEL="gpt-4o-mini"
