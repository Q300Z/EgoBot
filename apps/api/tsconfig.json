{
	"compilerOptions": {
		"incremental": true,
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"paths": {
			"@agelid/shared-models": ["../packages/shared-models/src"]
		},
		"rootDir": "..",
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": false,
		"noEmit": false,
		"outDir": "build",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": false,
		"noImplicitAny": false,
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["vitest/globals"]
	},
	"include": ["src/**/*.ts", "src/**/__tests__/*.ts", "src/scripts/*.ts", "../packages/shared-models/src/**/*.ts"],
	"exclude": ["build", "node_modules", "dist", "build_output"]
}
