generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Conversation {
  id         String    @id @default(uuid())
  user_id    String
  client_id  String
  title      String
  model      Model
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  jobs       Job[]
  messages   Message[]

  @@index([user_id])
}

enum Status {
  COMPLETED   @map("completed")
  PENDING     @map("pending")
  IN_PROGRESS @map("in_progress")
  FAILED      @map("failed")
  CANCELLED   @map("cancelled")
  DEFERRED    @map("deferred")

  @@map("status_job")
}

enum Model {
  CHATBOT       @map("chatbot")

  @@map("model_enum")
}

model Job {
  id                   String @id @default(uuid())
  conversation_id      String
  user_prompt_id       String
  assistant_message_id String

  status Status @default(PENDING)
  model  Model

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  started_at          DateTime?
  ended_at            DateTime?
  error               String?
  generated_tokens    Int?
  time_to_first_token Float?
  tokens_per_second   Float?

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  user_prompt       Message @relation("UserPrompt", fields: [user_prompt_id], references: [id], onDelete: Cascade)
  assistant_message Message @relation("AssistantMessage", fields: [assistant_message_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
}

enum Role {
  USER      @map("user")
  ASSISTANT @map("assistant")

  @@map("message_role")
}

model Message {
  id              String   @id @default(uuid())
  conversation_id String
  role            Role
  content         String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user_prompt_jobs       Job[] @relation("UserPrompt")
  assistant_message_jobs Job[] @relation("AssistantMessage")

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String?  @unique
  password_hash String
  role          String   @default("USER")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

