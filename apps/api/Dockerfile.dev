FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

WORKDIR /app

# Copier l'ensemble du monorepo pour le linking workspace
COPY . .

RUN pnpm install
RUN pnpm --filter api exec prisma generate
RUN pnpm --filter @egobot/logistics-agent exec prisma generate
RUN mkdir -p /app/apps/api/data /app/packages/logistics-agent/data

EXPOSE 8000

CMD ["pnpm", "--filter", "api", "dev"]
