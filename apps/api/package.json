{
	"name": "llm-api",
	"version": "1.0.0",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.js",
		"build": "pnpm prisma:generate && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
		"preview": "node dist/index.js",
		"format": "prettier --write .",
		"check-types": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prisma": "prisma",
		"prisma:push": "prisma db push",
		"prisma:generate": "prisma generate",
		"prisma:studio": "prisma studio",
		"test": "vitest run --fileParallelism=false --maxWorkers=1",
		"test:coverage": "vitest run --coverage --fileParallelism=false --maxWorkers=1",
		"test:load": "npx tsx src/scripts/load-test.ts"
	},
	"author": "Thomas Boutin",
	"license": "ISC",
	"description": "",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/compression": "^1.8.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.3.0",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^3.2.7",
		"esbuild": "^0.28.2",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.9.6",
		"prisma": "^7.9.1",
		"supertest": "^7.2.2",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@valkey/valkey-glide": "^2.5.2",
		"compression": "^1.8.1",
		"cors": "^2.8.6",
		"egoroof-blowfish": "^4.0.3",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.2",
		"helmet": "^8.3.0",
		"jose": "^6.2.10",
		"multer": "^2.2.0",
		"pino": "^10.3.1",
		"redis": "^6.2.1",
		"zod": "^4.4.3"
	}
}
