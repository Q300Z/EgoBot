# =========================================================
# Variables d'environnement - API EgoBot
# =========================================================
# Ce fichier décrit l'ensemble des variables d'environnement
# utilisées par l'application API Express / Valkey / Prisma.
# =========================================================

# ---------------------------------------------------------
# 1. Environnement général & Serveur HTTP
# ---------------------------------------------------------

# NODE_ENV : Mode d'exécution de l'application.
# - development : Mode développement local avec logs détaillés.
# - production  : Mode production strict (exige des secrets sécurisés).
# - test        : Mode exécuté lors des suites de tests automatisés.
# Valeurs possibles : development | production | test
# Valeur par défaut : development
NODE_ENV=development

# PORT : Port d'écoute TCP du serveur HTTP Express.
# Valeurs possibles : entier > 0 (ex: 8000, 3000)
# Valeur par défaut : 8000
PORT=8000

# CORS_ORIGIN : Origine(s) autorisée(s) pour les requêtes HTTP Cross-Origin (CORS).
# IMPORTANT : En production, ne pas laisser "*" pour éviter les attaques cross-site.
# Indiquer l'URL exacte du frontend web (ex: https://egobot.domain.com).
# Valeurs possibles : URL(s) séparées par des virgules ou "*" (développement uniquement)
# Valeur par défaut : *
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------
# 2. Base de données & ORM Prisma
# ---------------------------------------------------------

# API_DATABASE_URL : Chaîne de connexion pour l'API (Prisma SQLite).
API_DATABASE_URL=file:./dev.db

# PRISMA_DISABLED : Désactive l'initialisation et l'accès à la base de données Prisma.
# Utilisé principalement pour des tests ou un fonctionnement mémoire sans persistance.
# Valeurs possibles : true | false
# Valeur par défaut : false
PRISMA_DISABLED=false

# ---------------------------------------------------------
# 3. Sécurité & Authentification (JWT)
# ---------------------------------------------------------

# JWT_SECRET : Clé secrète utilisée pour signer et vérifier les tokens JWT.
# SÉCURITÉ :
# - En production, cette clé DOIT comporter au moins 32 caractères aléatoires.
# - Les valeurs génériques par défaut sont automatiquement rejetées au démarrage.
# - Génération recommandée : `openssl rand -hex 32`
# Valeurs possibles : chaîne secrète de 32 caractères minimum
JWT_SECRET=change_me_with_a_long_random_secret_at_least_32_chars

# ---------------------------------------------------------
# 4. Connexion Valkey / Redis
# ---------------------------------------------------------

# VALKEY_URL : URL de connexion au serveur/cluster Valkey (ou Redis).
# Format : redis://[utilisateur:mot_de_passe@]hote:port[/db]
# Valeurs possibles : URL Valkey ou Redis valide
# Valeur par défaut : redis://127.0.0.1:6379
VALKEY_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------
# 5. Optimisations Valkey GLIDE (Résilience & Haute Performance)
# ---------------------------------------------------------

# VALKEY_ENABLE_CLIENT_CACHE : Active le cache local en mémoire côté client (Client-Side Caching).
# Valkey GLIDE exploite le protocole RESP3 pour stocker localement les lectures répétées
# (ex: configuration, profils utilisateurs) et les invalider automatiquement via le serveur.
# Évite des allers-retours réseau inutiles.
# Valeurs possibles : true | false
# Valeur par défaut : true
VALKEY_ENABLE_CLIENT_CACHE=true

# VALKEY_CACHE_SIZE_KB : Taille mémoire maximale allouée au cache côté client en kilooctets.
# Valeurs possibles : entier > 0 (Ko)
# Valeur par défaut : 1024 (1 Mo)
VALKEY_CACHE_SIZE_KB=1024

# VALKEY_CACHE_TTL_MS : Durée de rétention maximale (TTL) des éléments mis en cache local en ms.
# Valeurs possibles : entier > 0 (ms)
# Valeur par défaut : 60000 (60 secondes)
VALKEY_CACHE_TTL_MS=60000

# VALKEY_ENABLE_CIRCUIT_BREAKER : Active le coupe-circuit (Circuit Breaker) intégré de Glide.
# En cas d'indisponibilité ou d'erreur répétée sur le cluster Valkey, le circuit s'ouvre
# immédiatement pour protéger l'API Express contre l'accumulation de requêtes bloquées.
# Valeurs possibles : true | false
# Valeur par défaut : activé automatiquement en production (NODE_ENV=production)
VALKEY_ENABLE_CIRCUIT_BREAKER=true