# =========================================================
# Environnement de l'API
# Chaque variable ci-dessous inclut:
# - son role
# - les valeurs possibles
# =========================================================

# NODE_ENV: mode d'execution de Node.js.
# Valeurs possibles: development | test | production
NODE_ENV=development

# ---------------------------------------------------------
# Base de donnees / Prisma
# ---------------------------------------------------------

# POSTGRES_HOSTNAME: hote PostgreSQL (utile si vous construisez DATABASE_URL avec interpolation).
# Valeurs possibles: nom DNS ou IP (ex: localhost, postgre)
POSTGRES_HOSTNAME=localhost

# POSTGRES_PORT: port PostgreSQL.
# Valeurs possibles: entier > 0 (souvent 5432)
POSTGRES_PORT=5432

# POSTGRES_USER: utilisateur PostgreSQL.
# Valeurs possibles: texte non vide
POSTGRES_USER=postgres

# POSTGRES_PASSWORD: mot de passe PostgreSQL.
# Valeurs possibles: texte (vide possible selon votre setup)
POSTGRES_PASSWORD=password

# POSTGRES_DB: nom de base PostgreSQL.
# Valeurs possibles: texte non vide
POSTGRES_DB=db

# DATABASE_URL: chaine de connexion Prisma.
# Valeurs possibles: URL valide postgresql://... ou sqlite://... selon votre cible
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOSTNAME}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# PRISMA_DISABLED: force le mode fichier (sans Prisma) quand true.
# Valeurs possibles: true | false
PRISMA_DISABLED=false

# ---------------------------------------------------------
# Fallback fichier conversations
# ---------------------------------------------------------

# CONVERSATION_FALLBACK_ENABLED: active/desactive le stockage fichier des conversations.
# Valeurs possibles: true | false
CONVERSATION_FALLBACK_ENABLED=true

# CONVERSATION_FALLBACK_ROOT: dossier racine du stockage fichier.
# Valeurs possibles: chemin absolu ou relatif
CONVERSATION_FALLBACK_ROOT=./data/conversations

# ---------------------------------------------------------
# Authentification
# ---------------------------------------------------------

# SECRET_KEY: cle de signature JWT.
# Valeurs possibles: texte long et aleatoire (obligatoire en production)
SECRET_KEY=change_me_with_a_long_random_secret

# SECRET_KEY_SALT: cout de hachage (si utilise par vos flux d'auth).
# Valeurs possibles: entier >= 8 (souvent 10 a 12)
SECRET_KEY_SALT=10

# INIT: drapeau d'initialisation applicative (premier boot / seed admin).
# Valeurs possibles: true | false
INIT=false

# ---------------------------------------------------------
# Redis / cache
# ---------------------------------------------------------

# CACHE_HOSTNAME: hote Redis.
# Valeurs possibles: nom DNS ou IP (ex: localhost, redis)
CACHE_HOSTNAME=localhost

# CACHE_PORT: port Redis.
# Valeurs possibles: entier > 0 (souvent 6379)
CACHE_PORT=6379

# CACHE_PASSWORD: mot de passe Redis.
# Valeurs possibles: texte (laisser vide si non protege)
CACHE_PASSWORD=

# CACHE_DB_NAME: index de base Redis.
# Valeurs possibles: entier >= 0
CACHE_DB_NAME=0

# CACHE_EXPIRE: TTL par defaut du cache en secondes (si applique par vos services).
# Valeurs possibles: entier > 0
CACHE_EXPIRE=3600

# ---------------------------------------------------------
# SSE / workers
# ---------------------------------------------------------

# WORKER_STATUS_INTERVAL_MS: frequence de publication du statut workers.
# Valeurs possibles: entier > 0 (millisecondes)
WORKER_STATUS_INTERVAL_MS=5000

# JOB_WORKER_STEP_DELAY_MS: delai simule entre etapes de job.
# Valeurs possibles: entier > 0 (millisecondes)
JOB_WORKER_STEP_DELAY_MS=1000

# JOB_WORKER_TOTAL_STEPS: nombre total d'etapes simulees par job.
# Valeurs possibles: entier > 0
JOB_WORKER_TOTAL_STEPS=5

# SSE_STREAM_READ_BLOCK_MS: timeout BLOCK pour XREAD.
# Valeurs possibles: entier > 0 (millisecondes)
SSE_STREAM_READ_BLOCK_MS=5000

# SSE_STREAM_MAX_LENGTH: longueur max des Redis streams de jobs.
# Valeurs possibles: entier > 0
SSE_STREAM_MAX_LENGTH=1000

# SSE_REPLAY_LIMIT: nombre max d'evenements replayes a la reconnexion.
# Valeurs possibles: entier > 0
SSE_REPLAY_LIMIT=200

# SSE_SCAN_COUNT: taille de lot SCAN Redis.
# Valeurs possibles: entier > 0
SSE_SCAN_COUNT=500

# SSE_SCAN_MAX_ITERATIONS: limite de boucles SCAN pour proteger les perfs.
# Valeurs possibles: entier > 0
SSE_SCAN_MAX_ITERATIONS=100

# SSE_SCAN_TIMEOUT_MS: timeout global d'un SCAN.
# Valeurs possibles: entier > 0 (millisecondes)
SSE_SCAN_TIMEOUT_MS=30000

# PORT: Port d'ecoute du serveur
PORT=3000

# REDIS_URL: URL globale de connexion Redis (alternative ou complémentaire aux variables CACHE_*)
REDIS_URL=redis://127.0.0.1:6379