# Stage 1: Prune monorepo workspace for web
FROM node:22-alpine AS pruner
WORKDIR /app
RUN npm install -g turbo@2.10.5
COPY . .
RUN turbo prune @my-llm/web --docker

# Stage 2: Install dependencies & compile static assets
FROM node:22-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm@11.9.0

# Copy manifests first for optimal layer caching
COPY --from=pruner /app/out/json/ .
RUN pnpm install

# Copy source code and build web bundle
COPY --from=pruner /app/out/full/ .
RUN pnpm build

# Stage 3: Minimal Nginx Runner (Dive Minimal Layer Image)
FROM nginx:alpine AS runner

COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

