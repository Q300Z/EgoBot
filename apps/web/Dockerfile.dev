FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

WORKDIR /app

COPY . .

RUN pnpm install
# @egobot/web importe @egobot/sdk via des exports pointant vers dist/ : sans
# ce build, Vite échoue à résoudre ces modules au démarrage.
RUN pnpm exec turbo build --filter=@egobot/web^...

EXPOSE 3000

CMD ["pnpm", "--filter", "@egobot/web", "dev", "--host"]
