# ==============================================================================
# 🚀 EGOBOT MONOREPO — FICHIER DE CONFIGURATION D'ENVIRONNEMENT GLOBAL
# ==============================================================================
# Ce fichier recense TOUTES les variables d'environnement utilisées par :
# - apps/api (Serveur HTTP Express, Valkey Glide, Prisma SQLite)
# - apps/worker (Worker d'inférence TypeScript, bus d'événements)
# - packages/logistics-agent (Agent LangChain, Prisma SQLite, outils métiers)
# - apps/web (Interface Vue 3, client SDK, proxy Vite)
# - Infrastructure Docker Compose (développement et production)
#
# Copier ce fichier en `.env` à la racine avant de lancer l'application :
#   cp .env.example .env (ou exécuter : pnpm env:init)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONNEMENT GÉNÉRAL & SERVEUR HTTP API (apps/api)
# ------------------------------------------------------------------------------

# Mode d'exécution de l'application.
# - development : logs verbeux, initialisation souple, préfixe file Valkey 'jobs:queue:dev:*'
# - production  : sécurité stricte (rejet des secrets par défaut), préfixe 'jobs:queue:prod:*'
# - test        : utilisé lors de l'exécution des suites Vitest automatisées
# Valeurs possibles : development | production | test
# Valeur par défaut : development
NODE_ENV=development

# Active le mode dev étendu pour les logs internes et traces SSE.
# Valeurs possibles : true | false
# Valeur par défaut : false
DEV_MODE=false

# Port d'écoute TCP du serveur HTTP Express de l'API.
# Valeurs possibles : entier > 0 (ex: 8000)
# Valeur par défaut : 8000
PORT=8000

# Origine(s) HTTP autorisée(s) pour les requêtes Cross-Origin (CORS).
# IMPORTANT : Le frontend Vue 3 tourne sur le port 3000 par défaut.
# En production, spécifier le nom de domaine exact (ex: https://egobot.mon-domaine.com).
# Valeurs possibles : URL avec protocole et port, ou "*" en dev
# Valeur par défaut : http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Niveau minimal de verbosité du logger Pino.
# Valeurs possibles : fatal | error | warn | info | debug | trace | silent
# Valeur par défaut : debug (en dev), info (en prod)
LOG_LEVEL=debug


# ------------------------------------------------------------------------------
# 2. BASES DE DONNÉES SQLITE (DÉCOUPLAGE PRISMA 7)
# ------------------------------------------------------------------------------
# Le monorepo utilise deux bases de données SQLite indépendantes.
# Pour éviter tout conflit de nom, les variables sont préfixées par service.

# Chaîne de connexion Prisma pour l'API Express (Utilisateurs, Conversations, Messages, Jobs).
# - En local natif  : file:./apps/api/dev.db (ou file:./dev.db depuis apps/api)
# - Sous Docker dev : file:/app/apps/api/data/dev.db (volume persistant nommé)
# Valeur par défaut : file:./dev.db
API_DATABASE_URL=file:./dev.db

# Chaîne de connexion Prisma pour l'Agent Logistique (Clients, Commandes, Livraisons, Stocks).
# - En local natif  : file:./packages/logistics-agent/logistics.db
# - Sous Docker dev : file:/app/packages/logistics-agent/data/logistics.db
# Valeur par défaut : file:./logistics.db
LOGISTICS_DATABASE_URL=file:./logistics.db

# Désactive l'initialisation et les requêtes Prisma au démarrage de l'API (mode dégradé / mock).
# Valeurs possibles : true | false
# Valeur par défaut : false
PRISMA_DISABLED=false


# ------------------------------------------------------------------------------
# 3. SÉCURITÉ & AUTHENTIFICATION (JWT)
# ------------------------------------------------------------------------------

# Clé secrète cryptographique utilisée pour signer et vérifier les tokens d'authentification JWT.
# SÉCURITÉ :
# - Doit comporter AU MOINS 32 caractères aléatoires en production (sinon l'API refuse de démarrer).
# - En dev local, la valeur par défaut ci-dessous est acceptée pour démarrer immédiatement.
# - Commande recommandée pour générer une clé forte : openssl rand -base64 48
# Valeur par défaut : super_secret_jwt_key_for_dev_environment_at_least_32_chars
JWT_SECRET=super_secret_jwt_key_for_dev_environment_at_least_32_chars


# ------------------------------------------------------------------------------
# 4. INFRASTRUCTURE VALKEY / REDIS & CLIENT GLIDE
# ------------------------------------------------------------------------------

# URL de connexion au broker Valkey / Redis (utilisée par l'API et le Worker).
# Format : redis://[utilisateur:mot_de_passe@]hote:port[/db]
# - En local natif : redis://127.0.0.1:6379
# - Sous Docker dev : redis://valkey:6379
# Valeur par défaut : redis://127.0.0.1:6379
VALKEY_URL=redis://127.0.0.1:6379

# Paramètres de performance Valkey GLIDE (Client-Side Caching RESP3) :
# Active le cache en mémoire vive local au processus Node.js pour éviter les allers-retours réseau.
# Valeurs possibles : true | false
# Valeur par défaut : true
VALKEY_ENABLE_CLIENT_CACHE=true

# Taille maximale en Ko allouée au cache côté client.
# Valeur par défaut : 1024 (1 Mo)
VALKEY_CACHE_SIZE_KB=1024

# Durée de vie maximale (TTL) en millisecondes des données en cache local.
# Valeur par défaut : 60000 (60 secondes)
VALKEY_CACHE_TTL_MS=60000

# Coupe-circuit (Circuit Breaker) protégeant l'API en cas d'indisponibilité de Valkey.
# Valeurs possibles : true | false
# Valeur par défaut : true
VALKEY_ENABLE_CIRCUIT_BREAKER=true


# ------------------------------------------------------------------------------
# 5. MODÈLES D'INFÉRENCE LLM (apps/worker & packages/logistics-agent)
# ------------------------------------------------------------------------------

# Fournisseur de modèle pour l'agent logistique LangChain.
# - openai : utilise l'API OpenAI officielle (ChatOpenAI)
# - azure  : utilise Azure OpenAI / Azure AI Foundry
# Valeurs possibles : openai | azure
# Valeur par défaut : openai
LOGISTICS_MODEL_PROVIDER=openai

# Nom du modèle LLM à invoquer pour l'agent de suivi logistique.
# Exemples : gpt-4o-mini, gpt-4o, gpt-5
# Valeur par défaut : gpt-4o-mini
LOGISTICS_MODEL=gpt-4o-mini

# --- OPTION A : Configuration OpenAI (si LOGISTICS_MODEL_PROVIDER=openai) ---
# Clé d'API OpenAI. Facultative au premier boot dev (le worker démarre sans crasher
# et renvoie un message explicite si un job logistique est sollicité).
# Valeur par défaut : sk-dummy-key-for-local-dev
OPENAI_API_KEY=sk-dummy-key-for-local-dev

# --- OPTION B : Configuration Azure OpenAI (si LOGISTICS_MODEL_PROVIDER=azure) ---
# AZURE_OPENAI_API_KEY=votre_cle_secrete_azure
# AZURE_OPENAI_ENDPOINT=https://votre-ressource.openai.azure.com/
# AZURE_OPENAI_API_DEPLOYMENT_NAME=votre-deploiement-gpt4o
# AZURE_OPENAI_API_VERSION=2024-10-21


# ------------------------------------------------------------------------------
# 6. FRONTEND WEB & PROXY VITE (apps/web)
# ------------------------------------------------------------------------------

# Cible réseau du serveur backend Express pour le proxy de développement Vite.
# - En local natif : http://localhost:8000
# - Sous Docker dev : http://api:8000 (résolution DNS interne du service Compose)
# Valeur par défaut : http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000

# Base URL pour les requêtes de l'application frontend.
# Laisser vide ("") en développement pour émettre des requêtes relatives servies
# par le proxy Vite (contourne automatiquement tout blocage CORS).
# Valeur par défaut : vide
VITE_API_URL=

# Active le polling Chokidar sous Docker pour garantir la détection du hot-reload
# sur les systèmes de fichiers virtualisés (macOS VirtioFS, Windows WSL2/9p).
# Valeurs possibles : true | false
# Valeur par défaut : false (en natif), injecté à 'true' automatiquement dans docker-compose
CHOKIDAR_USEPOLLING=false


# ------------------------------------------------------------------------------
# 7. DONNÉES DE TEST & IDENTIFIANTS ADMIN
# ------------------------------------------------------------------------------

# Identifiants du compte administrateur créé automatiquement lors du seed de l'API.
ADMIN_EMAIL=admin@egobot.local
ADMIN_PASSWORD=Password123!

# Adresse email cible à rattacher au client possédant le plus de commandes lors du seed.
# Permet au compte administrateur créé dans l'API de tester immédiatement le chatbot.
# Valeur par défaut : admin@egobot.local
LINK_EMAIL=admin@egobot.local
