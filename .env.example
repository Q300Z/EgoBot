# Variables consommees par docker-compose.prod.yml.
# Copier en .env a la racine avant `docker compose -f docker-compose.prod.yml up`.
#
# Les trois variables marquees REQUISE n'ont volontairement pas de valeur par
# defaut : compose refuse de demarrer si elles manquent, plutot que de lancer la
# production avec un secret public.

# REQUISE — signature des jetons JWT. Generer une valeur aleatoire longue,
# par exemple : openssl rand -base64 48
JWT_SECRET=

# REQUISE — mot de passe PostgreSQL de l'agent logistique.
POSTGRES_PASSWORD=

# REQUISE — cle OpenAI utilisee par l'agent logistique (ChatOpenAI).
OPENAI_API_KEY=

# Facultatives : les valeurs ci-dessous sont les valeurs par defaut.
POSTGRES_USER=egobot
POSTGRES_DB=egobot
LOGISTICS_MODEL=gpt-5

# Origines autorisees par CORS. "*" convient en developpement ; en production,
# renseigner le domaine du front, par exemple https://egobot.example.com
CORS_ORIGIN=*
