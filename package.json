{
  "name": "egobot",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "dev": "docker compose -f docker-compose.dev.yml up --remove-orphans",
    "dev:build": "docker compose -f docker-compose.dev.yml up --build --remove-orphans",
    "dev:down": "docker compose -f docker-compose.dev.yml down --remove-orphans",
    "dev:reset": "docker compose -f docker-compose.dev.yml down -v --remove-orphans",
    "dev:native": "turbo run dev --parallel",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d valkey",
    "infra:down": "docker compose -f docker-compose.dev.yml stop valkey",
    "build": "turbo run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter api exec prisma migrate dev && pnpm --filter @egobot/logistics-agent exec prisma migrate dev",
    "db:seed": "pnpm --filter api run seed && pnpm --filter @egobot/logistics-agent exec prisma db seed && pnpm --filter @egobot/logistics-agent exec tsx scripts/link-customer.ts admin@egobot.local",
    "db:reset": "pnpm --filter api exec prisma migrate reset --force && pnpm --filter @egobot/logistics-agent exec prisma migrate reset --force && pnpm run db:seed",
    "db:studio:api": "pnpm --filter api exec prisma studio --port 5555",
    "db:studio:logistics": "pnpm --filter @egobot/logistics-agent exec prisma studio --port 5556"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@types/eventsource": "^3.0.0",
    "eventsource": "^4.1.1"
  }
}
