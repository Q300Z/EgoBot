# Base PostgreSQL de l'agent logistique.
# Utilisée par Prisma (schema, migrations, seed) et par le client applicatif.
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/egobot"

# Clé API OpenAI — requise par l'agent LangChain (src/agent/create-logistics-agent.ts).
# Sans elle, createLogisticsAgent échoue à l'instanciation de ChatOpenAI.
OPENAI_API_KEY="sk-..."

# Modèle utilisé par l'agent. Facultatif — défaut : gpt-5.
LOGISTICS_MODEL="gpt-5"
