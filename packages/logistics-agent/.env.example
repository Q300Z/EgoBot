# Base SQLite locale de l'agent logistique (fichier créé automatiquement par
# `prisma migrate dev`). Utilisée par Prisma (schema, migrations, seed) et par
# le client applicatif (src/database/prisma.ts, adaptateur better-sqlite3).
DATABASE_URL="file:./logistics.db"

# ── Fournisseur du modèle ──────────────────────────────────────────
# LOGISTICS_MODEL_PROVIDER sélectionne le fournisseur par défaut : "openai"
# (défaut) ou "azure". Voir README.md > "Utiliser Azure OpenAI" pour le détail.
LOGISTICS_MODEL_PROVIDER=openai

# Option 1 — OpenAI (LOGISTICS_MODEL_PROVIDER=openai, ou absent) :
# Clé API OpenAI — requise par l'agent LangChain (src/agent/create-logistics-agent.ts).
# Sans elle, createLogisticsAgent échoue à l'instanciation de ChatOpenAI.
OPENAI_API_KEY="sk-..."

# Option 2 — Azure OpenAI / Azure AI Foundry (LOGISTICS_MODEL_PROVIDER=azure) :
# AZURE_OPENAI_API_KEY="..."
# AZURE_OPENAI_ENDPOINT="https://mon-instance.services.ai.azure.com"
# AZURE_OPENAI_API_DEPLOYMENT_NAME="mon-deploiement"
# AZURE_OPENAI_API_VERSION="2024-10-21"

# Modèle utilisé par l'agent. Facultatif — défaut : gpt-5.
LOGISTICS_MODEL="gpt-5"
